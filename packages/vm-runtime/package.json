{
  "name": "@ventostack/vm-runtime",
  "version": "0.1.1",
  "description": "N-API client for VentoAgentRuntime Firecracker sandboxes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ventorium/VentoAgentRuntime.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../bindings/vm-napi/Cargo.toml --output-dir .",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "test": "bun test"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.4.1"
  },
  "napi": {
    "binaryName": "vento_vm_runtime",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  }
}
